# SPDX-License-Identifier: MIT
[Unit]
Description=enzimOS disposable VM provisioning diagnostic
DefaultDependencies=no
Requires=systemd-udevd.service
After=systemd-udevd.service systemd-udev-trigger.service
OnFailure=poweroff.target
[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/lib/enzimos-lab/provision.sh
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TimeoutStartSec=15min
